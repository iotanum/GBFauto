# 0 - OFF
# 1 - ON

# Logging in
# If 0 then bot automatically uses information below
# And the Google+ method
# Otherwise - bot waits for you to log in
MANUAL_LOGIN = 0
GBF_LOGIN =
GBF_PASSWORD =

# Chrome headless mode. Leave it at 0 (default) for the time being
HEADLESS_MODE = 0

# Undetected_chrome version of this bot; fixes google login
UC_MODE = 0

# Press full_auto/semi_auto in the loading screen or during the fight?
AUTO_IN_LOADING_SCREEN = 0

# Use this when you want to reach a certain amount of points 
# in a raid (for example: 300k for a m2 blue chest)
# Type in an amount that you want (for example 300000)
# Bot will turn on auto attacks and will keep it until it reaches 300k
# If nothing is provided by default bot will attack only 1 time
POINT_THRESHOLD = 
# 1 for enabled and 0 for disabled
# if enabled - optimizes every run to save seconds
GW = 1


# Your skill queue
# a = 1st skill, b = 2nd skill and so on, delimited by ">"
# Example: 1a > 5b
# This would mean bot would start with the first char's first skill 
# followed by using 2nd summon

# This also supports 'Select party member' abilities
# Example: 3b2
# This would mean that the bot would click 3rd character 2nd skill
# and use it on your 2nd 'teammate'

# For 'Raid' type of fights (only 1 battle, aka non quest type) first queue line will be used
QUEUE_FIRST_FIGHT =
QUEUE_SECOND_FIGHT =
QUEUE_THIRD_FIGHT =

# Refresh page upon every skill (and summon) usage
# when there's no queue
# 1 - ON
# 0 - OFF
FA_REFRESH = 0
RAIDS_LOWER_HP_LIMIT = 35
RAIDS_UPPER_HP_LIMIT = 100

# Extreme+ Raid Battles
# Handle if re-occuring Extreme+ battles should be ignored
# or handled manually
# Example: Nightmare Halo or ROTB extreme+ battles
# Defaults are: skip extreme battles, cancel (if popup present) backup requests
EXTREME_BATTLES = 0
REQUEST_BACKUP = 0

# Support Summon Element
# 1 - Fire
# 2 - Water
# 3 - Earth
# 4 - Wind
# 5 - Light
# 6 - Dark
# If you're picking your support summon manually - element (below) gets ignored

# You can also specify on what support summon to pick below
# It is delimited by ", ", for example: Ygg, Alex
# This would mean that the bot would prioritize Yggrasil summon before Alex
# It finds the best possible support summon (by it's level)
# that there is on the given list in the game
MANUAL_SUPPORT_PICKING = 0
SUPPORT_ELEMENT =
SUPPORT_SUMMONS_TO_PICK = 