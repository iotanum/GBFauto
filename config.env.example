# 0 - OFF
# 1 - ON

# Logging in
# If 0 then bot automatically uses information below
# And the Google+ method
# Otherwise - bot waits for you to log in
MANUAL_LOGIN = 0
GBF_LOGIN =
GBF_PASSWORD =

HEADLESS_MODE = 0

# Raids
# Naming is in english according to http://gbf-raidfinder.aikats.us
RAID_BOSS_NAME =

# Your skill queue
# a = 1st skill, b = 2nd skill and so on, delimited by ">"
# Example: 1a > 5b
# This would mean bot would start with the first char's first skill 
# followed by using 2nd summon

# This also supports 'Select party member' abilities
# Example: 3b2
# This would mean that the bot would click 3rd character 2nd skill
# and use it on your 2nd 'teammate'

# For 'Raid' type of fights (only 1 battle, aka non quest type) first queue line will be used
QUEUE_FIRST_FIGHT =
QUEUE_SECOND_FIGHT =
QUEUE_THIRD_FIGHT =

# Extreme+ Raid Battles
# Handle if re-occuring Extreme+ battles should be ignored
# or handled manually
# Example: Nightmare Halo or ROTB extreme+ battles
EXTREME_BATTLES =
REQUEST_BACKUP = 1

# Support Summon Element
# 1 - Fire
# 2 - Water
# 3 - Earth
# 4 - Wind
# 5 - Light
# 6 - Dark
# If you're picking your support summon manually - element (below) gets ignored

# You can also specify on what support summon to pick below
# It is delimited by ", ", for example: Ygg, Alex
# This would mean that the bot would prioritize Yggrasil summon before Alex
# It finds the best possible support summon (by it's level)
# that there is on the given list in the game
MANUAL_SUPPORT_PICKING = 0
SUPPORT_ELEMENT =
SUPPORT_SUMMONS_TO_PICK = 